# =========================
# Node / Frontend
# =========================
node_modules/
apps/web/node_modules/
apps/web/node_modules/.vite/
apps/web/dist/

# =========================
# Backend storage
# =========================
backend/api/storage/*.json

# =========================
# Env files
# =========================
apps/web/.env
apps/web/.env.local

# =========================
# Expo (local only)
# =========================
.expo/
apps/mobile/.expo/
.expo-shared/

# =========================
# Native builds (CNG — regenerated by `expo prebuild` from app.json + plugins)
# =========================
apps/mobile/ios/
apps/mobile/android/

# =========================
# Build outputs
# =========================
dist/
web-build/

# =========================
# Package managers
# =========================
package-lock.json
# EAS Build uploads by these rules: the mobile lockfile must be uploaded, or the
# build resolves fresh dependency versions with yarn.
!apps/mobile/package-lock.json

# =========================
# Logs
# =========================
*.log

.claude/settings.json
# Landing hero video source (compressed output committed instead)
apps/web/public/landing/randomwithmeal.mp4
# Uncompressed video masters - kept out of public/ so Vite never copies them into dist/
apps/web/landing-src/

# i18n translation passes (tools/i18n/export.mjs)
/tmp/
