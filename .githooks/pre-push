#!/bin/sh
#
# Lint apps/web before it can reach main.
#
# Why: `vite build` bundles without resolving free identifiers, so a hook used
# without being imported (`useCallback` in App.jsx) built green and white-screened
# every web user. `eslint no-undef` catches that in about a second.
#
# Only runs when the push actually contains apps/web changes - a backend- or
# mobile-only push is untouched. Bypass with `git push --no-verify`.
#
# Installed via: git config core.hooksPath .githooks

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
ZERO=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

# stdin: <local ref> <local sha> <remote ref> <remote sha> per pushed ref.
web_touched=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion - nothing to lint

  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch on the remote: diff against the default branch instead of the
    # whole history, so a first push doesn't lint every commit ever made.
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
    range=${base:+$base..$local_sha}
  else
    range="$remote_sha..$local_sha"
  fi

  # No resolvable range (detached / missing origin/main) - lint to be safe.
  if [ -z "$range" ]; then web_touched=1; break; fi

  if git diff --name-only "$range" -- apps/web | grep -q .; then
    web_touched=1
    break
  fi
done

[ "$web_touched" -eq 0 ] && exit 0

echo "pre-push: linting apps/web…"
if ! npm --prefix "$REPO_ROOT/apps/web" run --silent lint; then
  echo ""
  echo "pre-push: lint failed - push aborted."
  echo "  Fix the errors above, or bypass with: git push --no-verify"
  exit 1
fi
echo "pre-push: lint clean."
